{
  "name": "vite-plugin-local-webfonts",
  "version": "0.1.1",
  "description": "Download web fonts (Google Fonts, Bunny Fonts, and more) into your Vite build output",
  "author": "NietThijmen <53520119+NietThijmen@users.noreply.github.com>",
  "homepage": "https://github.com/NietThijmen/vite-fonts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NietThijmen/vite-fonts.git"
  },
  "bugs": {
    "url": "https://github.com/NietThijmen/vite-fonts/issues"
  },
  "keywords": [
    "vite",
    "plugin",
    "fonts",
    "google-fonts",
    "bunny-fonts",
    "fontshare",
    "adobe-fonts",
    "webfonts",
    "download",
    "privacy",
    "performance"
  ],
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
